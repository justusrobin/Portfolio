# EmailJS Configuration for Portfolio Contact Form
# Get these from your EmailJS Dashboard: https://dashboard.emailjs.com/
# 1. Service ID: Created under 'Email Services' (e.g., service_xxxxxxx)
# 2. Template ID: Created under 'Email Templates' (e.g., template_xxxxxxx)
# 3. Public Key: Found under 'Account' -> 'API Keys' -> 'Public Key' (e.g., user_xxxxxxx or xxxxxx)

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

